DATABASE_URL=postgresql://lighthouse:lighthouse_dev_pw@localhost:5432/lighthouse_dev?sslmode=disable
REDIS_URL=redis://localhost:6379

MASTER_ENCRYPTION_KEY=replace-with-openssl-rand-base64-32

LOG_LEVEL=info
HTTP_ADDR=:8081
WORK_DIR=./data/deployments

# ---- routing ----
# local  -> http on *.localhost (dev, no TLS)
# server -> https on *.${BASE_DOMAIN} (Traefik + Let's Encrypt, prod)
MODE=local
# Apex used to build deploy URLs: <env>.<project>.<username>.${BASE_DOMAIN}
BASE_DOMAIN=localhost
# Disk sweep: reclaim terminal deployments older than the retention window.
SWEEP_INTERVAL=1h
SWEEP_RETENTION=168h
